@page "/bookings"
@rendermode InteractiveServer
@inject BookingService BookingService
@inject RoomService RoomService

<PageTitle>Bokningar</PageTitle>

<h1>Kommande bokningar</h1>

<div class="mb-3">
    <label class="form-label" for="roomFilter">Visa rum</label>
    <select id="roomFilter" class="form-select" @bind="selectedRoomId" @bind:after="LoadBookings">
        <option value="">Alla rum</option>
        @foreach (var room in rooms)
        {
            <option value="@room.Id">@room.Name</option>
        }
    </select>
</div>

@if (bookings.Count == 0)
{
    <p>Det finns inga kommande bokningar.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Rum</th>
                <th>Bokat av</th>
                <th>Antal personer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.Date</td>
                    <td>@booking.RoomName</td>
                    <td>@booking.BookedBy</td>
                    <td>@booking.Guests</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-primary" href="bookings/new">Ny bokning</a>

@code {
    private IReadOnlyList<Room> rooms = [];
    private IReadOnlyList<BookingOverview> bookings = [];
    private int? selectedRoomId;

    protected override void OnInitialized()
    {
        rooms = RoomService.GetAll();
        LoadBookings();
    }

    private void LoadBookings()
    {
        bookings = BookingService.GetUpcoming(selectedRoomId);
    }
}
